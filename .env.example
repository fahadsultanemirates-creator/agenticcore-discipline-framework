# Copy this file to .env and fill in real values. Never commit .env.

# --- MetaTrader 5 (only needed for the real bridge; ignored by --mock) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Path to terminal64.exe if MT5 isn't installed in the default location.
MT5_TERMINAL_PATH=

# --- Telegram alerting ---
# Create a bot via @BotFather, then message it once and hit
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Live execution safety gate ---
# Required (in addition to enforcement.allow_live_execution: true in
# config/settings.yaml) before "active" or "hybrid" mode will place, modify,
# or close a single real order. Leave unset/false until the client has
# explicitly signed off on live execution.
DISCIPLINE_FRAMEWORK_CONFIRM_LIVE=false
