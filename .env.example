# Copy this file to .env and fill in real values. Never commit .env.
#
# One MT5 login/password/server/terminal-path per account, using the env
# var names declared in that account's config/accounts.yaml entry (mt5.*_env
# fields). The names below match the two placeholder accounts shipped in
# config/accounts.yaml — add/rename a block per account as you add/rename
# accounts there. Real MT5 credential login IDs are numeric; if the account
# id ever needs a login stored as text, it still goes through this pattern.

# --- MT5: account_1 (only needed for the real bridge; ignored by --mock) ---
MT5_ACCOUNT_1_LOGIN=
MT5_ACCOUNT_1_PASSWORD=
MT5_ACCOUNT_1_SERVER=
# Path to terminal64.exe if MT5 isn't installed in the default location.
# Each account normally needs its own MT5 terminal *installation* (not just
# a login) to run truly simultaneously — see docs/MULTI_ACCOUNT.md.
MT5_ACCOUNT_1_TERMINAL_PATH=

# --- MT5: account_2 ---
MT5_ACCOUNT_2_LOGIN=
MT5_ACCOUNT_2_PASSWORD=
MT5_ACCOUNT_2_SERVER=
MT5_ACCOUNT_2_TERMINAL_PATH=

# --- Telegram alerting + command interface (shared by all accounts) ---
# Create a bot via @BotFather, then message it once and hit
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
# TELEGRAM_BOT_TOKEN also powers the /setrisk <account>, /status, /pause,
# etc. command interface — see docs/TELEGRAM_COMMANDS.md, and lock down
# telegram.authorized_user_ids in config/settings.yaml before go-live.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Live execution safety gate (one global switch for the whole deployment) ---
# Required (in addition to a per-account enforcement.allow_live_execution:
# true in config/accounts.yaml) before "active" or "hybrid" mode will
# place, modify, or close a single real order on ANY account. Leave
# unset/false until the client has explicitly signed off on live execution.
# This stays a single global var (not per-account) so there's one place
# that turns live trading on for this deployment at all — see
# docs/MULTI_ACCOUNT.md for the reasoning.
DISCIPLINE_FRAMEWORK_CONFIRM_LIVE=false
